# ==============================================================================
# Slay the Spire LLM Agent 配置文件 (.env)
# 复制本文件为 .env 并填入你的 API Key 即可快速切换不同的模型
# ==============================================================================

# 选择当前启用的 Provider: deepseek | kimi | gemini | custom
LLM_PROVIDER=deepseek

# ------------------------------------------------------------------------------
# 1. DeepSeek 配置 (推荐: 极高智商与性价比，支持思维链推理)
# 官网: https://platform.deepseek.com/
# ------------------------------------------------------------------------------
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# 可选模型: deepseek-chat (通用快速) 或 deepseek-reasoner (R1 推理大模型)
DEEPSEEK_MODEL=deepseek-chat

# ------------------------------------------------------------------------------
# 2. Kimi (Moonshot AI) 配置
# 官网: https://platform.moonshot.cn/
# ------------------------------------------------------------------------------
KIMI_API_KEY=your_kimi_api_key_here
KIMI_BASE_URL=https://api.moonshot.cn/v1
# 可选模型: moonshot-v1-8k, moonshot-v1-32k, moonshot-v1-128k
KIMI_MODEL=moonshot-v1-8k

# ------------------------------------------------------------------------------
# 3. Google Gemini 配置 (使用 Google 官方 OpenAI 兼容接口)
# 官网: https://aistudio.google.com/
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# 可选模型: gemini-1.5-flash, gemini-2.0-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-2.0-flash

# ------------------------------------------------------------------------------
# 4. 网络代理配置 (访问海外 API 如 Gemini 时如果需要可开启)
# ------------------------------------------------------------------------------
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# ------------------------------------------------------------------------------
# 5. 战斗推演模式配置 (自主心算 vs 工具辅助)
# ------------------------------------------------------------------------------
# ENABLE_TOOLS: 是否开启本地 ReAct 工具支持 (true / false，默认 true)
# 设置为 false 时，完全走纯 CoT 心算模式，单次请求出结果，响应最快且最省 Token
ENABLE_TOOLS=true

# ENABLE_CALCULATOR: 是否向大模型暴露伤害与格挡试算器 calculate_card_sequence (true / false，默认 true)
# 设置为 false 时，模型自己根据卡牌面板数值计算伤害，保留怪物机制情报等工具
ENABLE_CALCULATOR=true

# ------------------------------------------------------------------------------
# 6. (可选) 宏观长线战略模型配置 (双模型 / 双 API 物理隔离架构)
# 用于战后抓牌选牌、商店消费删牌、营地休整锻造、路线规划与事件抉择。
# 若留空，系统自动继承上方主模型配置；若配置，则实现 KV Cache 物理隔离与异构模型搭配！
# ------------------------------------------------------------------------------
# MACRO_LLM_PROVIDER=deepseek
# MACRO_LLM_MODEL=deepseek-chat
# MACRO_LLM_API_KEY=your_macro_api_key_here
# MACRO_LLM_BASE_URL=https://api.deepseek.com/v1
# MACRO_LLM_TEMPERATURE=0.6

